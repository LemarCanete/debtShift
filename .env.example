# DebtShift Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# AI Companion (Claude API)
# Get this from: https://console.anthropic.com/
# Note: This should be stored in Supabase Edge Function secrets, not in client
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Push Notifications (Optional for development)
# Get this from Expo dashboard: https://expo.dev/accounts/[account]/projects/[project]/credentials
EXPO_PUBLIC_PUSH_TOKEN=ExponentPushToken[xxx]

# Environment
NODE_ENV=development
